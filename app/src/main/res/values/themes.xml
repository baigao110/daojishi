<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/glass_bg_center</item>
        <item name="android:windowBackground">@drawable/glass_bg</item>
        <item name="android:statusBarColor">@color/glass_bg_bottom</item>
        <item name="android:navigationBarColor">@color/glass_bg_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/glass_accent</item>
        <item name="android:colorPrimary">@color/glass_accent</item>
        <item name="android:colorPrimaryDark">@color/glass_accent_deep</item>
        <!-- 让所有 AlertDialog（含直接 AlertDialog.Builder 的提示框）也套用液态玻璃面板 -->
        <item name="android:alertDialogTheme">@style/GlassDialogTheme</item>
        <item name="android:dialogTheme">@style/GlassDialogTheme</item>
    </style>

    <!-- 液态玻璃对话框主题：半透明深底 + 青色描边圆角面板，文字与按钮强调色沿用玻璃色板 -->
    <style name="GlassDialogTheme" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">@color/glass_accent</item>
        <item name="android:textColorPrimary">@color/glass_text</item>
        <item name="android:textColorSecondary">@color/glass_text_sub</item>
        <item name="android:textColor">@color/glass_text</item>
    </style>

    <style name="UpdateTransparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
    </style>

    <style name="LockKeepTheme" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
    </style>

    <style name="CalHead">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/glass_text_sub</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="GlassSwitch">
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:switchMinWidth">56dp</item>
        <item name="android:showText">false</item>
        <item name="android:splitTrack">false</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="GlassSpinner">
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:popupBackground">@color/glass_surface</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/glass_chip</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/glass_text</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
