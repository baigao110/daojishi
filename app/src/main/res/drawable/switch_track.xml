<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_accent_soft"/>
            <corners android:radius="15dp"/>
            <stroke android:width="1dp" android:color="@color/neu_accent"/>
            <size android:width="48dp" android:height="28dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_chip"/>
            <corners android:radius="15dp"/>
            <stroke android:width="1dp" android:color="@color/neu_shadow_dark"/>
            <size android:width="48dp" android:height="28dp"/>
        </shape>
    </item>
</selector>
