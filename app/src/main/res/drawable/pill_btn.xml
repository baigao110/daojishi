<?xml version="1.0" encoding="utf-8"?>
<!-- 新拟态：凸起的主操作按钮（浅色面 + 双投影，字用强调色） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle"><solid android:color="@color/neu_shadow_dark"/><corners android:radius="26dp"/></shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="@color/neu_shadow_light"/><corners android:radius="26dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/neu_surface"/><corners android:radius="26dp"/></shape>
    </item>
</layer-list>
